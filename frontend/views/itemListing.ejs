<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Search Results | reGive</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/searchstyle.css">
</head>

<body>
    <!-- Assuming you have a partial for the main navigation/header -->
    <!-- If your navbar is not a partial, you may need to include the HTML for it here. -->

    <!-- This wrapper is likely for the back button and sits below the main navbar -->
    <div class="search-nav-wrapper">
        <button id="Back-Button">Back to Home</button>
    </div>

    <main class="results-page">
        <h2>Search Results</h2>
        
        <% if (items.length===0) { %>
        <p class="no-results-message">No results found matching your query. Please try searching for a different item or category.</p>
        <% } else { %>
        
        <!-- Main container for the card grid -->
        <div class="item-card-grid"> 
            <% items.forEach(item=> { %>
            
            <!-- Individual Item Card -->
            <div class="item-card">
                
                <!-- NEW LOCATION: Text Content for Name and Category (TOP) -->
                <div class="card-content-top">
                    <p class="item-name" onclick="window.location.href='/item/<%= item._id %>'">
                        <%= item.name %>
                    </p>

                    <!-- Display Category Name -->
                    <% if (item.categoryId && item.categoryId.name) { %>
                        <p class="item-category">
                            <%= item.categoryId.name %>
                        </p>
                    <% } %>
                </div>

                <!-- Image Container (MIDDLE) -->
                <div class="card-image-container" onclick="window.location.href='/item/<%= item._id %>'">
                    <% 
                        // Use the first image URL from the array. Fallback to stock image.
                        const imageUrls = item.imageURL && item.imageURL.length > 0 ? item.imageURL : ['/img/stock-item.jpg'];
                        const firstImage = imageUrls[0];
                        const imageSrc = firstImage.startsWith('http') || firstImage.startsWith('/') ? firstImage : '/uploads/' + firstImage;
                    %>
                    <img src="<%= imageSrc %>" 
                         alt="<%= item.name %> image" 
                         class="card-image" 
                         onerror="this.onerror=null; this.src='/img/stock-item.jpg';" >
                </div>

                <!-- Text Content for Description (BELOW IMAGE) -->
                <div class="card-content-bottom">
                    <p class="item-description" onclick="window.location.href='/item/<%= item._id %>'">
                        <!-- Truncate description for card view -->
                        <%= item.description.substring(0, 100) + (item.description.length > 100 ? '...' : '') %>
                    </p>
                </div>


                <!-- Action Bar (Price/Button - BOTTOM) -->
                <div class="card-actions">
                    <% if (item.price > 0) { %>
                        <!-- BUY Item: Show Price on the left and Buy button on the right -->
                        <div class="item-price buy-price">
                            $<%= item.price.toFixed(2) %>
                        </div>
                        <button class="action-button buy-button" onclick="window.location.href='/item/<%= item._id %>?action=buy'">
                            Buy
                        </button>
                    <% } else { %>
                        <!-- FREE Item: Show "FREE" label and Claim button -->
                        <div class="item-price item-free">
                            FREE
                        </div>
                        <button class="action-button claim-button" onclick="window.location.href='/item/<%= item._id %>?action=claim'">
                            Claim
                        </button>
                    <% } %>
                </div>
                <!-- End Action Bar -->
            </div>
            <% }) %>
        </div>
        <% } %>
    </main>

    <script>
        // Back Button Logic
        document.addEventListener('DOMContentLoaded', () => {
            const backButton = document.getElementById('Back-Button');
            if (backButton) {
                backButton.addEventListener('click', () => {
                    // Navigate back to the main homepage
                    window.location.href = '/';
                });
            }
        });
    </script>
</body>

</html>
